<!doctype html>

<html lang="{{ request.locale.iso_code }}">

  <head>

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Koezina cart drawer %}
    {{ 'koezina-cart-drawer.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

  </head>

  <body>

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% render 'koezina-cart-drawer' %}

    <script
      src="{{ 'koezina-cart-drawer.js' | asset_url }}"
      defer
    ></script>

  </body>

</html>