{% javascript %}

  (() => {

    const SELECTOR =
      '[data-koezina-product]';

    const initProduct = (section) => {

      if (
        !section ||
        section.dataset.koezinaProductInitialized === 'true'
      ) {
        return;
      }

      section.dataset.koezinaProductInitialized =
        'true';

      const thumbnails =
        Array.from(
          section.querySelectorAll(
            '[data-product-thumbnail]'
          )
        );

      const mediaItems =
        Array.from(
          section.querySelectorAll(
            '[data-product-media]'
          )
        );

      const variantSelect =
        section.querySelector(
          '[data-product-variant-select]'
        );

      const price =
        section.querySelector(
          '[data-product-price]'
        );

      const comparePrice =
        section.querySelector(
          '[data-product-compare-price]'
        );

      const availability =
        section.querySelector(
          '[data-product-availability]'
        );

      const availabilityDot =
        section.querySelector(
          '[data-product-availability-dot]'
        );

      const submit =
        section.querySelector(
          '[data-product-submit]'
        );

      const submitText =
        section.querySelector(
          '[data-product-submit-text]'
        );

      const quantityInput =
        section.querySelector(
          '[data-quantity-input]'
        );

      const minus =
        section.querySelector(
          '[data-quantity-minus]'
        );

      const plus =
        section.querySelector(
          '[data-quantity-plus]'
        );

      const showMedia = (
        mediaId
      ) => {

        if (!mediaId) {
          return;
        }

        mediaItems.forEach(
          (item) => {

            item.classList.toggle(
              'is-active',
              item.dataset.productMedia ===
                String(mediaId)
            );

          }
        );

        thumbnails.forEach(
          (thumbnail) => {

            thumbnail.classList.toggle(
              'is-active',
              thumbnail.dataset.productThumbnail ===
                String(mediaId)
            );

          }
        );
      };

      thumbnails.forEach(
        (thumbnail) => {

          thumbnail.addEventListener(
            'click',
            () => {

              showMedia(
                thumbnail.dataset.productThumbnail
              );

            }
          );

        }
      );

      if (variantSelect) {

        variantSelect.addEventListener(
          'change',
          () => {

            const option =
              variantSelect.options[
                variantSelect.selectedIndex
              ];

            if (!option) {
              return;
            }

            if (price) {
              price.textContent =
                option.dataset.price || '';
            }

            if (comparePrice) {

              const value =
                option.dataset.comparePrice || '';

              comparePrice.textContent =
                value;

              comparePrice.hidden =
                !value;
            }

            const isAvailable =
              option.dataset.available ===
              'true';

            if (availability) {

              availability.textContent =
                isAvailable
                  ? 'Op voorraad'
                  : 'Momenteel uitverkocht';

            }

            if (availabilityDot) {

              availabilityDot.classList.toggle(
                'is-unavailable',
                !isAvailable
              );

            }

            if (submit) {
              submit.disabled =
                !isAvailable;
            }

            if (submitText) {

              submitText.textContent =
                isAvailable
                  ? 'In winkelmand'
                  : 'Uitverkocht';

            }

            const mediaId =
              option.dataset.mediaId;

            if (mediaId) {
              showMedia(mediaId);
            }

          }
        );
      }

      if (
        minus &&
        quantityInput
      ) {

        minus.addEventListener(
          'click',
          () => {

            const current =
              Math.max(
                1,
                parseInt(
                  quantityInput.value,
                  10
                ) || 1
              );

            quantityInput.value =
              Math.max(
                1,
                current - 1
              );

          }
        );
      }

      if (
        plus &&
        quantityInput
      ) {

        plus.addEventListener(
          'click',
          () => {

            const current =
              Math.max(
                1,
                parseInt(
                  quantityInput.value,
                  10
                ) || 1
              );

            quantityInput.value =
              current + 1;

          }
        );
      }

    };

    const initAll = (
      root = document
    ) => {

      if (
        root.matches?.(
          SELECTOR
        )
      ) {
        initProduct(root);
      }

      root
        .querySelectorAll?.(
          SELECTOR
        )
        .forEach(
          initProduct
        );

    };

    if (
      document.readyState ===
      'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        () => initAll()
      );

    } else {

      initAll();

    }

    document.addEventListener(
      'shopify:section:load',
      (event) => {

        initAll(
          event.target
        );

      }
    );

  })();

{% endjavascript %}

