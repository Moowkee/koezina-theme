<section class="koezina-categories">
  <div class="koezina-categories__inner">

    <div class="koezina-categories__header">
      <p class="koezina-categories__eyebrow">
        Explore the collection
      </p>

      <h2>
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="koezina-categories__grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        <a
          class="koezina-category-card"
          href="{{ collection.url | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="koezina-category-card__image-wrapper">

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  class: 'koezina-category-card__image'
              }}

            {% elsif collection != blank and collection.featured_image != blank %}
              {{
                collection.featured_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  class: 'koezina-category-card__image'
              }}

            {% else %}
              <div class="koezina-category-card__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

          </div>

          <div class="koezina-category-card__content">
            <h3>
              {% if block.settings.title != blank %}
                {{ block.settings.title }}
              {% elsif collection != blank %}
                {{ collection.title }}
              {% else %}
                Collection
              {% endif %}
            </h3>

            <span>
              Shop now →
            </span>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
  .koezina-categories {
    background: #f8f5f0;
    padding: 88px 32px;
  }

  .koezina-categories__inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .koezina-categories__header {
    text-align: center;
    margin-bottom: 44px;
  }

  .koezina-categories__eyebrow {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a8076;
  }

  .koezina-categories__header h2 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 400;
    line-height: 1;

    color: #2c2823;
  }

  .koezina-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .koezina-category-card {
    color: #2c2823;
    text-decoration: none;
  }

  .koezina-category-card__image-wrapper {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ece6de;
  }

  .koezina-category-card__image,
  .koezina-category-card__placeholder,
  .koezina-category-card__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .koezina-category-card__image {
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .koezina-category-card:hover .koezina-category-card__image {
    transform: scale(1.025);
  }

  .koezina-category-card__content {
    padding-top: 17px;
  }

  .koezina-category-card__content h3 {
    margin: 0 0 7px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 21px;
    font-weight: 400;
  }

  .koezina-category-card__content span {
    font-size: 12px;
    color: #777067;
  }

  @media screen and (max-width: 1000px) {
    .koezina-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .koezina-categories {
      padding: 64px 20px;
    }

    .koezina-categories__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koezina categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Eigen afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Eigen titel"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Koezina categories",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}