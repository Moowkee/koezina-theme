{% comment %}
  Koezina Contact page
{% endcomment %}

<section
  id="KoezinaContact-{{ section.id }}"
  class="koezina-contact"
>

  <!-- ======================================
       HERO
  ======================================= -->

  <div class="koezina-contact__hero">

    <div class="koezina-contact__hero-inner">

      <div class="koezina-contact__hero-copy">

        {% if section.settings.hero_eyebrow != blank %}
          <p class="koezina-contact__eyebrow">
            {{ section.settings.hero_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.hero_heading != blank %}
          <h1>
            {{ section.settings.hero_heading }}
          </h1>
        {% endif %}

      </div>

      {% if section.settings.hero_text != blank %}
        <div class="koezina-contact__hero-text">
          {{ section.settings.hero_text }}
        </div>
      {% endif %}

    </div>

  </div>

  <!-- ======================================
       CONTACT
  ======================================= -->

  <div class="koezina-contact__main">

    <div class="koezina-contact__info">

      <div class="koezina-contact__info-intro">

        <p class="koezina-contact__eyebrow">
          {{ section.settings.info_eyebrow }}
        </p>

        <h2>
          {{ section.settings.info_heading }}
        </h2>

        {% if section.settings.info_text != blank %}
          <div class="koezina-contact__info-text">
            {{ section.settings.info_text }}
          </div>
        {% endif %}

      </div>

      <div class="koezina-contact__details">

        <div class="koezina-contact__detail">

          <span class="koezina-contact__detail-label">
            E-mail
          </span>

          <a href="mailto:{{ section.settings.email }}">
            {{ section.settings.email }}
          </a>

        </div>

        <div class="koezina-contact__detail">

          <span class="koezina-contact__detail-label">
            Reactietijd
          </span>

          <p>
            {{ section.settings.response_text }}
          </p>

        </div>

      </div>

      <div class="koezina-contact__help">

        <p class="koezina-contact__help-title">
          Waar kunnen we mee helpen?
        </p>

        <div class="koezina-contact__help-items">

          <div class="koezina-contact__help-item">
            <span>01</span>

            <div>
              <h3>Bestellingen</h3>
              <p>
                Vragen over een bestelling, levering of de status van je pakket.
              </p>
            </div>
          </div>

          <div class="koezina-contact__help-item">
            <span>02</span>

            <div>
              <h3>Retourneren</h3>
              <p>
                Hulp nodig met een retour of heb je een vraag over ons retourproces?
              </p>
            </div>
          </div>

          <div class="koezina-contact__help-item">
            <span>03</span>

            <div>
              <h3>Algemene vragen</h3>
              <p>
                Voor productvragen, samenwerkingen of andere vragen over Koezina.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ======================================
         FORM
    ======================================= -->

    <div class="koezina-contact__form-wrapper">

      <div class="koezina-contact__form-heading">

        <p class="koezina-contact__eyebrow">
          Stuur ons een bericht
        </p>

        <h2>
          Hoe kunnen we je helpen?
        </h2>

      </div>

      {% form 'contact', class: 'koezina-contact__form' %}

        {% if form.posted_successfully? %}

          <div
            class="koezina-contact__success"
            tabindex="-1"
            autofocus
          >
            <div class="koezina-contact__success-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12.5L9.5 17L19 7.5"></path>
              </svg>
            </div>

            <div>
              <strong>Bedankt voor je bericht.</strong>
              <p>
                We hebben je bericht ontvangen en nemen zo snel mogelijk contact met je op.
              </p>
            </div>
          </div>

        {% endif %}

        {% if form.errors %}

          <div class="koezina-contact__errors">

            <strong>
              Controleer de onderstaande gegevens.
            </strong>

            {{ form.errors | default_errors }}

          </div>

        {% endif %}

        <div class="koezina-contact__form-row">

          <div class="koezina-contact__field">

            <label for="ContactName-{{ section.id }}">
              Naam
            </label>

            <input
              id="ContactName-{{ section.id }}"
              type="text"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% endif %}"
              autocomplete="name"
              placeholder="Je naam"
            >

          </div>

          <div class="koezina-contact__field">

            <label for="ContactEmail-{{ section.id }}">
              E-mailadres *
            </label>

            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="jij@voorbeeld.nl"
              required
            >

          </div>

        </div>

        <div class="koezina-contact__form-row">

          <div class="koezina-contact__field">

            <label for="ContactSubject-{{ section.id }}">
              Onderwerp
            </label>

            <div class="koezina-contact__select">

              <select
                id="ContactSubject-{{ section.id }}"
                name="contact[Onderwerp]"
              >
                <option value="Algemene vraag">
                  Algemene vraag
                </option>

                <option value="Bestelling">
                  Bestelling
                </option>

                <option value="Retourneren">
                  Retourneren
                </option>

                <option value="Productvraag">
                  Productvraag
                </option>

                <option value="Samenwerking">
                  Samenwerking
                </option>

                <option value="Anders">
                  Anders
                </option>
              </select>

              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M5 7.5L10 12.5L15 7.5"></path>
              </svg>

            </div>

          </div>

          <div class="koezina-contact__field">

            <label for="ContactOrder-{{ section.id }}">
              Bestelnummer
              <span>optioneel</span>
            </label>

            <input
              id="ContactOrder-{{ section.id }}"
              type="text"
              name="contact[Bestelnummer]"
              placeholder="Bijv. #1001"
            >

          </div>

        </div>

        <div class="koezina-contact__field">

          <label for="ContactMessage-{{ section.id }}">
            Bericht *
          </label>

          <textarea
            id="ContactMessage-{{ section.id }}"
            name="contact[body]"
            rows="8"
            placeholder="Vertel ons waarmee we je kunnen helpen..."
            required
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>

        </div>

        <button
          type="submit"
          class="koezina-contact__submit"
        >
          Verstuur bericht

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12H19"></path>
            <path d="M14 7L19 12L14 17"></path>
          </svg>
        </button>

        <p class="koezina-contact__privacy">
          Door het formulier te versturen, deel je deze gegevens met Koezina zodat we je vraag kunnen beantwoorden.
        </p>

      {% endform %}

    </div>

  </div>

  <!-- ======================================
       SERVICE STRIP
  ======================================= -->

  <div class="koezina-contact__service">

    <div class="koezina-contact__service-inner">

      <div class="koezina-contact-service">

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7H15V17H3Z"></path>
          <path d="M15 10H19L22 13V17H15Z"></path>
          <circle cx="7" cy="18" r="2"></circle>
          <circle cx="18" cy="18" r="2"></circle>
        </svg>

        <div>
          <strong>Bestellingen</strong>
          <span>Hulp bij je bestelling</span>
        </div>

      </div>

      <div class="koezina-contact-service">

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8L12 4L20 8L12 12Z"></path>
          <path d="M4 8V16L12 20L20 16V8"></path>
          <path d="M12 12V20"></path>
        </svg>

        <div>
          <strong>Productvragen</strong>
          <span>Meer weten over onze producten</span>
        </div>

      </div>

      <div class="koezina-contact-service">

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 11.5A8 8 0 1 1 16.6 5"></path>
          <path d="M20 4V10H14"></path>
        </svg>

        <div>
          <strong>Retourneren</strong>
          <span>Vragen over retourneren</span>
        </div>

      </div>

    </div>

  </div>

</section>

{% stylesheet %}

.koezina-contact,
.koezina-contact *,
.koezina-contact *::before,
.koezina-contact *::after {
  box-sizing: border-box;
}

.koezina-contact {
  width: 100%;

  background: #fffdf9;
  color: #29261f;
}

.koezina-contact__eyebrow {
  margin: 0 0 17px;

  color: #a48666;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: .22em;
  text-transform: uppercase;
}

/* =========================================
   HERO
========================================== */

.koezina-contact__hero {
  background: #eee7dd;
}

.koezina-contact__hero-inner {
  width: 100%;
  max-width: 1450px;
  min-height: 390px;

  margin: 0 auto;

  padding:
    75px
    48px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(280px, .8fr);

  align-items: end;

  gap: 80px;
}

.koezina-contact__hero h1 {
  max-width: 800px;

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(62px, 7vw, 96px);
  font-weight: 400;
  line-height: .93;

  letter-spacing: -.045em;
}

.koezina-contact__hero-text {
  max-width: 470px;

  padding-bottom: 9px;

  color: #69625a;

  font-size: 14px;
  line-height: 1.85;
}

.koezina-contact__hero-text p {
  margin: 0;
}

/* =========================================
   MAIN
========================================== */

.koezina-contact__main {
  width: 100%;
  max-width: 1450px;

  margin: 0 auto;

  padding:
    110px
    48px
    125px;

  display: grid;

  grid-template-columns:
    minmax(0, .85fr)
    minmax(500px, 1.15fr);

  gap: clamp(70px, 9vw, 145px);
}

/* =========================================
   INFO
========================================== */

.koezina-contact__info-intro {
  max-width: 520px;
}

.koezina-contact__info h2 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(42px, 4.4vw, 61px);
  font-weight: 400;
  line-height: 1;

  letter-spacing: -.035em;
}

.koezina-contact__info-text {
  max-width: 480px;

  margin-top: 25px;

  color: #726b63;

  font-size: 13px;
  line-height: 1.85;
}

.koezina-contact__info-text p {
  margin: 0;
}

.koezina-contact__details {
  margin-top: 55px;

  padding:
    28px
    0;

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 30px;

  border-top: 1px solid #e4ddd4;
  border-bottom: 1px solid #e4ddd4;
}

.koezina-contact__detail-label {
  display: block;

  margin-bottom: 8px;

  color: #a48666;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .15em;
  text-transform: uppercase;
}

.koezina-contact__detail a,
.koezina-contact__detail p {
  margin: 0;

  color: #29261f;

  font-size: 12px;
  line-height: 1.6;

  text-decoration: none;
}

.koezina-contact__detail a:hover {
  text-decoration: underline;

  text-underline-offset: 4px;
}

/* =========================================
   HELP
========================================== */

.koezina-contact__help {
  margin-top: 55px;
}

.koezina-contact__help-title {
  margin: 0 0 6px;

  color: #29261f;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: .14em;
  text-transform: uppercase;
}

.koezina-contact__help-items {
  margin-top: 21px;
}

.koezina-contact__help-item {
  padding:
    22px
    0;

  display: grid;

  grid-template-columns:
    38px
    1fr;

  gap: 10px;

  border-top: 1px solid #e4ddd4;
}

.koezina-contact__help-item:last-child {
  border-bottom: 1px solid #e4ddd4;
}

.koezina-contact__help-item > span {
  padding-top: 4px;

  color: #b89a73;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .12em;
}

.koezina-contact__help-item h3 {
  margin:
    0
    0
    5px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 21px;
  font-weight: 400;
}

.koezina-contact__help-item p {
  max-width: 390px;

  margin: 0;

  color: #777067;

  font-size: 11px;
  line-height: 1.7;
}

/* =========================================
   FORM WRAPPER
========================================== */

.koezina-contact__form-wrapper {
  padding:
    55px
    58px
    60px;

  background: #f1ebe3;
}

.koezina-contact__form-heading {
  margin-bottom: 40px;
}

.koezina-contact__form-heading h2 {
  max-width: 520px;

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(38px, 4vw, 54px);
  font-weight: 400;
  line-height: 1;

  letter-spacing: -.035em;
}

.koezina-contact__form {
  margin: 0;
}

.koezina-contact__form-row {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}

.koezina-contact__field {
  margin-bottom: 22px;
}

.koezina-contact__field label {
  display: flex;
  justify-content: space-between;

  margin-bottom: 9px;

  color: #3b3732;

  font-size: 10px;
  font-weight: 500;
}

.koezina-contact__field label span {
  color: #9b938a;

  font-size: 8px;

  text-transform: uppercase;
}

.koezina-contact__field input,
.koezina-contact__field textarea,
.koezina-contact__field select {
  width: 100%;

  border: 1px solid #d8d0c7;
  border-radius: 0;

  outline: none;

  background: #fffdf9;
  color: #29261f;

  font: inherit;
  font-size: 12px;

  transition: border-color .2s ease;
}

.koezina-contact__field input {
  height: 52px;

  padding:
    0
    15px;
}

.koezina-contact__field textarea {
  min-height: 180px;

  padding:
    15px;

  resize: vertical;

  line-height: 1.6;
}

.koezina-contact__field select {
  height: 52px;

  padding:
    0
    40px
    0
    15px;

  appearance: none;

  cursor: pointer;
}

.koezina-contact__field input:focus,
.koezina-contact__field textarea:focus,
.koezina-contact__field select:focus {
  border-color: #29261f;
}

.koezina-contact__field input::placeholder,
.koezina-contact__field textarea::placeholder {
  color: #aaa299;
}

.koezina-contact__select {
  position: relative;
}

.koezina-contact__select svg {
  position: absolute;

  top: 50%;
  right: 15px;

  width: 14px;
  height: 14px;

  transform: translateY(-50%);

  fill: none;
  stroke: #29261f;
  stroke-width: 1.2;

  pointer-events: none;
}

.koezina-contact__submit {
  width: 100%;
  min-height: 55px;

  padding:
    0
    22px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  border: 1px solid #29261f;

  background: #29261f;
  color: #fffdf9;

  font: inherit;
  font-size: 9px;
  font-weight: 600;

  letter-spacing: .11em;
  text-transform: uppercase;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease;
}

.koezina-contact__submit:hover {
  background: transparent;
  color: #29261f;
}

.koezina-contact__submit svg {
  width: 16px;
  height: 16px;

  fill: none;
  stroke: currentColor;

  stroke-width: 1.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.koezina-contact__privacy {
  max-width: 520px;

  margin:
    15px
    0
    0;

  color: #8b837b;

  font-size: 9px;
  line-height: 1.6;
}

/* =========================================
   MESSAGES
========================================== */

.koezina-contact__success {
  margin-bottom: 28px;

  padding: 18px;

  display: flex;
  align-items: flex-start;

  gap: 13px;

  border: 1px solid #c9c0b5;

  background: #fffdf9;
}

.koezina-contact__success-icon {
  width: 28px;
  height: 28px;

  flex: 0 0 auto;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #29261f;
  color: #fffdf9;
}

.koezina-contact__success-icon svg {
  width: 15px;
  height: 15px;

  fill: none;
  stroke: currentColor;

  stroke-width: 1.5;
}

.koezina-contact__success strong {
  display: block;

  margin-bottom: 3px;

  font-size: 11px;
}

.koezina-contact__success p {
  margin: 0;

  color: #777067;

  font-size: 10px;
  line-height: 1.6;
}

.koezina-contact__errors {
  margin-bottom: 28px;

  padding: 18px;

  border: 1px solid #b7776c;

  font-size: 11px;
}

.koezina-contact__errors strong {
  display: block;

  margin-bottom: 6px;
}

.koezina-contact__errors ul {
  margin:
    8px
    0
    0;

  padding-left: 18px;
}

/* =========================================
   SERVICE
========================================== */

.koezina-contact__service {
  border-top: 1px solid #e5ded5;

  background: #29261f;
  color: #fffdf9;
}

.koezina-contact__service-inner {
  width: 100%;
  max-width: 1450px;

  margin: 0 auto;

  padding:
    43px
    48px;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 30px;
}

.koezina-contact-service {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 17px;
}

.koezina-contact-service svg {
  width: 27px;
  height: 27px;

  flex: 0 0 auto;

  fill: none;
  stroke: #b89a73;

  stroke-width: 1.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.koezina-contact-service strong {
  display: block;

  margin-bottom: 4px;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: .08em;
  text-transform: uppercase;
}

.koezina-contact-service span {
  display: block;

  color: #bdb7af;

  font-size: 9px;
}

/* =========================================
   TABLET
========================================== */

@media screen and (max-width: 1000px) {

  .koezina-contact__hero-inner {
    padding:
      65px
      30px;
  }

  .koezina-contact__main {
    padding:
      85px
      30px
      100px;

    grid-template-columns:
      .8fr
      1.2fr;

    gap: 50px;
  }

  .koezina-contact__form-wrapper {
    padding:
      45px
      35px
      50px;
  }

}

/* =========================================
   MOBILE
========================================== */

@media screen and (max-width: 749px) {

  .koezina-contact__hero-inner {
    min-height: 390px;

    padding:
      60px
      20px;

    display: block;
  }

  .koezina-contact__hero h1 {
    font-size: 58px;
  }

  .koezina-contact__hero-text {
    margin-top: 30px;

    padding: 0;
  }

  .koezina-contact__main {
    padding:
      75px
      20px
      80px;

    display: block;
  }

  .koezina-contact__info h2 {
    font-size: 42px;
  }

  .koezina-contact__details {
    grid-template-columns: 1fr;

    gap: 22px;
  }

  .koezina-contact__form-wrapper {
    margin-top: 70px;

    padding:
      42px
      20px
      45px;
  }

  .koezina-contact__form-heading h2 {
    font-size: 40px;
  }

  .koezina-contact__form-row {
    display: block;
  }

  .koezina-contact__service-inner {
    padding:
      25px
      20px;

    display: block;
  }

  .koezina-contact-service {
    padding:
      20px
      0;

    justify-content: flex-start;

    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }

  .koezina-contact-service:last-child {
    border-bottom: 0;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Koezina contact",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Kleine tekst",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Titel",
      "default": "We'd love to hear from you"
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Tekst",
      "default": "<p>Heb je een vraag over een product, bestelling of iets anders? Stuur ons een bericht. We helpen je graag verder.</p>"
    },
    {
      "type": "header",
      "content": "Contactinformatie"
    },
    {
      "type": "text",
      "id": "info_eyebrow",
      "label": "Kleine tekst",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Titel",
      "default": "We're here to help"
    },
    {
      "type": "richtext",
