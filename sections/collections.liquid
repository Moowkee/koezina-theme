{% comment %}
  Koezina collections overview page
{% endcomment %}

{% assign visible_collection_count = 0 %}

{% for collection in collections %}
  {% unless collection.handle == 'frontpage' %}
    {% if section.settings.hide_empty_collections == false or collection.products_count > 0 %}
      {% assign visible_collection_count = visible_collection_count | plus: 1 %}
    {% endif %}
  {% endunless %}
{% endfor %}

<section
  id="KoezinaCollections-{{ section.id }}"
  class="koezina-collections"
>

  <div class="koezina-collections__hero">

    <div class="koezina-collections__hero-inner">

      {% if section.settings.eyebrow != blank %}
        <p class="koezina-collections__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1 class="koezina-collections__title">
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.description != blank %}
        <div class="koezina-collections__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>

  </div>

  <div class="koezina-collections__content">

    {% if visible_collection_count > 0 %}

      <div
        class="koezina-collections__grid{% if visible_collection_count == 1 %} koezina-collections__grid--single{% elsif visible_collection_count == 2 %} koezina-collections__grid--two{% endif %}"
      >

        {% for collection in collections %}

          {% unless collection.handle == 'frontpage' %}

            {% if section.settings.hide_empty_collections == false or collection.products_count > 0 %}

              {% assign card_image = collection.image %}

              {% if card_image == blank and collection.products.first.featured_image != blank %}
                {% assign card_image = collection.products.first.featured_image %}
              {% endif %}

              <article class="koezina-collection-card">

                <a
                  href="{{ collection.url }}"
                  class="koezina-collection-card__link"
                >

                  <div class="koezina-collection-card__media">

                    {% if card_image != blank %}

                      {{
                        card_image
                        | image_url: width: 1400
                        | image_tag:
                          class: 'koezina-collection-card__image',
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000, 1200, 1400',
                          sizes: '(max-width: 749px) 100vw, (max-width: 1100px) 50vw, 33vw',
                          alt: collection.title
                      }}

                    {% else %}

                      <div class="koezina-collection-card__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>

                    {% endif %}

                    <div class="koezina-collection-card__shade"></div>

                    <div class="koezina-collection-card__overlay">

                      <div>

                        <span class="koezina-collection-card__count">
                          {{ collection.products_count }}

                          {% if collection.products_count == 1 %}
                            product
                          {% else %}
                            producten
                          {% endif %}
                        </span>

                        <h2>
                          {{ collection.title }}
                        </h2>

                      </div>

                      <span class="koezina-collection-card__arrow">

                        <svg
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path d="M5 12H19"></path>
                          <path d="M14 7L19 12L14 17"></path>
                        </svg>

                      </span>

                    </div>

                  </div>

                </a>

              </article>

            {% endif %}

          {% endunless %}

        {% endfor %}

      </div>

    {% else %}

      <div class="koezina-collections__empty">

        <p class="koezina-collections__empty-eyebrow">
          Koezina
        </p>

        <h2>
          Onze collecties komen eraan
        </h2>

        <p>
          Binnenkort vind je hier onze verschillende
          categorieën en collecties.
        </p>

        <a href="{{ routes.all_products_collection_url }}">
          Bekijk alle producten
        </a>

      </div>

    {% endif %}

  </div>

  {% if section.settings.show_bottom_message %}

    <div class="koezina-collections__message">

      <div class="koezina-collections__message-inner">

        {% if section.settings.bottom_eyebrow != blank %}
          <p class="koezina-collections__message-eyebrow">
            {{ section.settings.bottom_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.bottom_heading != blank %}
          <h2>
            {{ section.settings.bottom_heading }}
          </h2>
        {% endif %}

        {% if section.settings.bottom_text != blank %}
          <p>
            {{ section.settings.bottom_text }}
          </p>
        {% endif %}

        {% if section.settings.bottom_button_label != blank %}
          <a href="{{ routes.all_products_collection_url }}">

            {{ section.settings.bottom_button_label }}

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12H19"></path>
              <path d="M14 7L19 12L14 17"></path>
            </svg>

          </a>
        {% endif %}

      </div>

    </div>

  {% endif %}

</section>

{% stylesheet %}

  .koezina-collections,
  .koezina-collections *,
  .koezina-collections *::before,
  .koezina-collections *::after {
    box-sizing: border-box;
  }

  .koezina-collections {
    width: 100%;

    background: #fffdf9;
    color: #29261f;
  }

  /* =========================================
     HERO
  ========================================== */

  .koezina-collections__hero {
    width: 100%;

    background: #eee7dd;
  }

  .koezina-collections__hero-inner {
    width: 100%;
    max-width: 1500px;
    min-height: 300px;

    margin: 0 auto;

    padding:
      58px
      clamp(48px, 7vw, 110px);

    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .koezina-collections__eyebrow {
    margin: 0 0 14px;

    color: #9f8264;

    font-size: 10px;
    font-weight: 600;

    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .koezina-collections__title {
    max-width: 850px;

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(50px, 6.3vw, 78px);
    font-weight: 400;
    line-height: .96;

    letter-spacing: -.045em;
  }

  .koezina-collections__description {
    max-width: 560px;

    margin-top: 22px;

    color: #686159;

    font-size: 13px;
    line-height: 1.8;
  }

  .koezina-collections__description p {
    margin: 0;
  }

  /* =========================================
     CONTENT
  ========================================== */

  .koezina-collections__content {
    width: 100%;
    max-width: 1600px;

    margin: 0 auto;

    padding:
      48px
      48px
      105px;
  }

  /* =========================================
     GRID
  ========================================== */

  .koezina-collections__grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;
  }

  .koezina-collections__grid--single {
    grid-template-columns:
      minmax(0, 520px);
  }

  .koezina-collections__grid--two {
    grid-template-columns:
      repeat(2, minmax(0, 520px));
  }

  .koezina-collection-card {
    min-width: 0;
  }

  .koezina-collection-card__link {
    display: block;

    color: inherit;

    text-decoration: none;
  }

  .koezina-collection-card__media {
    position: relative;

    width: 100%;
    .koezina-collection-card__media {
      aspect-ratio: 1.2 / 1;
    }

    overflow: hidden;

    background: #e9e2d9;
  }

  .koezina-collection-card__image,
  .koezina-collection-card__placeholder,
  .koezina-collection-card__placeholder svg {
    display: block;

    width: 100%;
    height: 100%;
  }

  .koezina-collection-card__image {
    object-fit: cover;

    transition:
      transform .75s cubic-bezier(.22, 1, .36, 1);
  }

  .koezina-collection-card__placeholder svg {
    background: #eee7dd;
  }

  .koezina-collection-card__shade {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(25, 22, 18, .72) 0%,
        rgba(25, 22, 18, .14) 46%,
        rgba(25, 22, 18, .02) 72%
      );
  }

  .koezina-collection-card__overlay {
    position: absolute;

    right: 0;
    bottom: 0;
    left: 0;

    padding: 28px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 25px;

    color: #fffdf9;
  }

  .koezina-collection-card__count {
    display: block;

    margin-bottom: 8px;

    color: rgba(255, 253, 249, .72);

    font-size: 9px;
    font-weight: 500;

    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .koezina-collection-card__overlay h2 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(28px, 2.3vw, 38px);
    font-weight: 400;
    line-height: 1;

    letter-spacing: -.025em;
  }

  .koezina-collection-card__arrow {
    flex: 0 0 46px;

    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255, 253, 249, .48);
    border-radius: 50%;

    transition:
      background .25s ease,
      color .25s ease,
      transform .35s cubic-bezier(.22, 1, .36, 1);
  }

  .koezina-collection-card__arrow svg {
    width: 17px;
    height: 17px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .koezina-collection-card__link:hover
    .koezina-collection-card__image {
    transform: scale(1.035);
  }

  .koezina-collection-card__link:hover
    .koezina-collection-card__arrow {
    background: #fffdf9;
    color: #29261f;

    transform: translateX(4px);
  }

  /* =========================================
     EMPTY STATE
  ========================================== */

  .koezina-collections__empty {
    max-width: 650px;

    margin:
      50px
      auto
      30px;

    padding:
      70px
      20px;

    text-align: center;
  }

  .koezina-collections__empty-eyebrow {
    margin: 0 0 14px;

    color: #aa8b68;

    font-size: 9px;
    font-weight: 600;

    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .koezina-collections__empty h2 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(36px, 4vw, 50px);
    font-weight: 400;

    line-height: 1;
  }

  .koezina-collections__empty > p:not(.koezina-collections__empty-eyebrow) {
    max-width: 430px;

    margin:
      19px
      auto
      27px;

    color: #81786f;

    font-size: 12px;
    line-height: 1.7;
  }

  .koezina-collections__empty a {
    min-height: 50px;

    padding:
      0
      27px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background: #29261f;
    color: #fffdf9;

    font-size: 9px;
    font-weight: 600;

    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* =========================================
     BOTTOM BRAND SECTION
  ========================================== */

  .koezina-collections__message {
    width: 100%;

    padding:
      90px
      48px
      100px;

    background: #29261f;
    color: #fffdf9;
  }

  .koezina-collections__message-inner {
    width: 100%;
    max-width: 830px;

    margin: 0 auto;

    text-align: center;
  }

  .koezina-collections__message-eyebrow {
    margin: 0 0 18px;

    color: #b89a73;

    font-size: 10px;
    font-weight: 600;

    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .koezina-collections__message h2 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(40px, 5vw, 64px);
    font-weight: 400;
    line-height: 1;

    letter-spacing: -.035em;
  }

  .koezina-collections__message-inner > p:not(.koezina-collections__message-eyebrow) {
    max-width: 540px;

    margin:
      24px
      auto
      0;

    color: rgba(255, 253, 249, .68);

    font-size: 13px;
    line-height: 1.8;
  }

  .koezina-collections__message a {
    min-height: 51px;

    margin-top: 30px;

    padding:
      0
      27px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    border: 1px solid rgba(255, 253, 249, .58);

    color: #fffdf9;

    font-size: 9px;
    font-weight: 600;

    letter-spacing: .11em;
    text-transform: uppercase;
    text-decoration: none;

    transition:
      background .2s ease,
      color .2s ease;
  }

  .koezina-collections__message a:hover {
    background: #fffdf9;
    color: #29261f;
  }

  .koezina-collections__message a svg {
    width: 15px;
    height: 15px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================================
     TABLET
  ========================================== */

  @media screen and (max-width: 1100px) {

    .koezina-collections__content {
      padding:
        35px
        30px
        85px;
    }

    .koezina-collections__grid,
    .koezina-collections__grid--two {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .koezina-collections__grid--single {
      grid-template-columns:
        minmax(0, 500px);
    }

  }

  /* =========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 749px) {

    .koezina-collections__hero-inner {
      min-height: 255px;

      padding:
        42px
        20px;
    }

    .koezina-collections__title {
      font-size: 50px;
    }

    .koezina-collections__description {
      margin-top: 18px;
    }

    .koezina-collections__content {
      padding:
        16px
        16px
        65px;
    }

    .koezina-collections__grid,
    .koezina-collections__grid--single,
    .koezina-collections__grid--two {
      grid-template-columns: 1fr;

      gap: 12px;
    }

    .koezina-collection-card__media {
      aspect-ratio: 1 / 1.08;
    }

    .koezina-collection-card__overlay {
      padding: 22px;
    }

    .koezina-collection-card__overlay h2 {
      font-size: 31px;
    }

    .koezina-collection-card__arrow {
      flex-basis: 42px;

      width: 42px;
      height: 42px;
    }

    .koezina-collections__empty {
      margin-top: 15px;

      padding:
        55px
        10px;
    }

    .koezina-collections__message {
      padding:
        68px
        20px
        74px;
    }

    .koezina-collections__message h2 {
      font-size: 42px;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    .koezina-collection-card__image,
    .koezina-collection-card__arrow {
      transition: none;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "Koezina collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tekst boven titel",
      "default": "Ontdek Koezina"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Collections"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschrijving",
      "default": "<p>Ontdek onze collecties met doordachte keukenproducten voor dagelijks gebruik.</p>"
    },
    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "Verberg lege collecties",
      "default": true
    },
    {
      "type": "header",
      "content": "Onderste sectie"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_message",
      "label": "Toon onderste merksectie",
      "default": true
    },
    {
      "type": "text",
      "id": "bottom_eyebrow",
      "label": "Kleine tekst",
      "default": "Small details. Big difference."
    },
    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Titel",
      "default": "Made for the heart of the home"
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Tekst",
      "default": "Rustige vormen, natuurlijke materialen en praktische details die van alledaagse momenten iets bijzonders maken."
    },
    {
      "type": "text",
      "id": "bottom_button_label",
      "label": "Knoptekst",
      "default": "Bekijk alle producten"
    }
  ]
}
{% endschema %}