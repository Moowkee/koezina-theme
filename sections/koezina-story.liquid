<section class="koezina-story">
  <div class="koezina-story__inner">

    <div class="koezina-story__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            class: 'koezina-story__image',
            alt: section.settings.image.alt
        }}
      {% else %}
        <div class="koezina-story__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="koezina-story__content">
      {% if section.settings.eyebrow != blank %}
        <p class="koezina-story__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2 class="koezina-story__title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.text != blank %}
        <div class="koezina-story__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="koezina-story__link"
          href="{{ section.settings.button_link | default: routes.root_url }}"
        >
          {{ section.settings.button_text }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
  .koezina-story {
    background: #eee7dd;
  }

  .koezina-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
  }

  .koezina-story__media {
    min-height: 620px;
    overflow: hidden;
    background: #e4ddd4;
  }

  .koezina-story__image,
  .koezina-story__placeholder,
  .koezina-story__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .koezina-story__image {
    object-fit: cover;
  }

  .koezina-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px clamp(48px, 7vw, 120px);
  }

  .koezina-story__eyebrow {
    margin: 0 0 18px;

    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    color: #81766b;
  }

  .koezina-story__title {
    max-width: 560px;
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;

    color: #2c2823;
  }

  .koezina-story__text {
    max-width: 540px;
    margin-top: 26px;

    font-size: 15px;
    line-height: 1.8;

    color: #665f57;
  }

  .koezina-story__text p {
    margin: 0;
  }

  .koezina-story__link {
    width: fit-content;
    margin-top: 30px;

    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: #2c2823;
    text-decoration: none;

    font-size: 13px;
    font-weight: 500;

    border-bottom: 1px solid #2c2823;
    padding-bottom: 4px;
  }

  .koezina-story__link span {
    transition: transform 0.2s ease;
  }

  .koezina-story__link:hover span {
    transform: translateX(4px);
  }

  @media screen and (max-width: 900px) {
    .koezina-story__inner {
      grid-template-columns: 1fr;
    }

    .koezina-story__media {
      min-height: 460px;
    }

    .koezina-story__content {
      padding: 64px 24px;
    }
  }

  @media screen and (max-width: 560px) {
    .koezina-story__media {
      min-height: 360px;
    }

    .koezina-story__content {
      padding: 52px 20px;
    }

    .koezina-story__title {
      font-size: 42px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koezina story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine tekst",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Made for the heart of the home"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>At Koezina, we believe the smallest details can make the biggest difference. Our kitchen essentials are selected with simplicity, function and timeless design in mind.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Linktekst",
      "default": "Discover Koezina"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Koezina story"
    }
  ]
}
{% endschema %}