<section class="koezina-collection-banner">
  <div class="koezina-collection-banner__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag:
          loading: 'lazy',
          class: 'koezina-collection-banner__image',
          alt: section.settings.image.alt
      }}
    {% else %}
      <div class="koezina-collection-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="koezina-collection-banner__overlay"></div>

  <div class="koezina-collection-banner__content">
    {% if section.settings.eyebrow != blank %}
      <p class="koezina-collection-banner__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    <h2 class="koezina-collection-banner__title">
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.text != blank %}
      <p class="koezina-collection-banner__text">
        {{ section.settings.text }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        class="koezina-collection-banner__button"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .koezina-collection-banner {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .koezina-collection-banner__media {
    position: absolute;
    inset: 0;
  }

  .koezina-collection-banner__image,
  .koezina-collection-banner__placeholder,
  .koezina-collection-banner__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .koezina-collection-banner__image {
    object-fit: cover;
  }

  .koezina-collection-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(30, 25, 20, 0.34);
  }

  .koezina-collection-banner__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding: 70px 28px;
    text-align: center;
    color: #ffffff;
  }

  .koezina-collection-banner__eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .koezina-collection-banner__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 6vw, 78px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .koezina-collection-banner__text {
    max-width: 560px;
    margin: 24px auto 0;
    font-size: 15px;
    line-height: 1.7;
  }

  .koezina-collection-banner__button {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 26px;
    background: #ffffff;
    color: #2c2823;
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .koezina-collection-banner__button:hover {
    opacity: 0.88;
  }

  @media screen and (max-width: 700px) {
    .koezina-collection-banner {
      min-height: 520px;
    }

    .koezina-collection-banner__content {
      padding: 54px 20px;
    }

    .koezina-collection-banner__title {
      font-size: 46px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koezina collection banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Achtergrondafbeelding"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine tekst",
      "default": "The essentials collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Small details. Big difference."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Thoughtful kitchen essentials designed to make everyday moments feel a little better."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knoptekst",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knoplink"
    }
  ],
  "presets": [
    {
      "name": "Koezina collection banner"
    }
  ]
}
{% endschema %}